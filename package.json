{
  "name": "gcmap-modern",
  "private": true,
  "version": "1.0.4",
  "description": "Great-circle route mapper with Apple Maps-style vector and satellite basemaps",
  "license": "MIT",
  "author": "pphun811-maker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pphun811-maker/GCMap-Modern.git"
  },
  "keywords": [
    "maplibre",
    "great-circle",
    "flight-routes",
    "react",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-style-labels.mjs && node scripts/run-sbf-parse-test.mjs && node scripts/run-search-test.mjs && node scripts/run-route-anim-test.mjs && node scripts/run-flight-timeline-test.mjs && node scripts/run-local-features-test.mjs",
    "build:airports": "node scripts/build-airports.mjs",
    "size": "node scripts/check-size.mjs",
    "test:static-map": "node scripts/test-static-map.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "maplibre-gl": "^5.24.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
